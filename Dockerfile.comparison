FROM agentprof-btp:review2
# Dependencies of the unmodified pinned Progent wrapper; no model SDK is invoked.
RUN pip install --no-cache-dir pydantic==2.12.3 jsonschema==4.25.1 \
    docstring-parser==0.17.0 z3-solver==4.15.4.0
COPY agentprof agentprof
COPY benchmarks benchmarks
COPY vendor/progent/full /opt/progent
COPY vendor/progent/provenance.json vendor/progent/LICENSE /opt/progent/
ENV PYTHONPATH=/opt/agentprof:/opt/progent SECAGENT_GENERATE=False ENABLE_SECAGENT=False
