{
  "schema": 2,
  "workflow": "repo-2-sqlite-report",
  "training_runs": 3,
  "include_rare": true,
  "rules": [
    {
      "kind": "read",
      "resource": "$input",
      "source": "paired-task-evidence"
    },
    {
      "kind": "write",
      "resource": "$output",
      "source": "paired-task-evidence"
    },
    {
      "kind": "exec",
      "resource": "/usr/local/bin/python3.13",
      "source": "stable-evidence"
    }
  ],
  "scopes": {
    "input": "/workspace/repo-2/input",
    "output": "/workspace/repo-2/out"
  },
  "protect_secrets": true,
  "trace_hashes": [
    "c64da8a55c8f0b703b30c1dadf2f0c3fc1928540fa1f4e186e0df74192fd1258",
