      "source": "stable-evidence"
    },
    {
      "kind": "read",
      "resource": "/proc/sys/vm/overcommit_memory",
      "source": "stable-evidence"
    }
  ],
  "scopes": {
    "input": "/workspace/repo-0/input",
    "output": "/workspace/repo-0/out"
  },
