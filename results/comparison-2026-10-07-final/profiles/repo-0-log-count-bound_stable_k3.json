{
  "schema": 2,
  "workflow": "repo-0-log-count",
  "training_runs": 3,
  "include_rare": false,
  "rules": [
    {
      "kind": "read",
      "resource": "$input",
      "source": "paired-task-evidence"
    },
    {
      "kind": "write",
      "resource": "$output",
      "source": "paired-task-evidence"
    },
    {
      "kind": "exec",
      "resource": "/usr/local/bin/python3.13",
      "source": "stable-evidence"
    },
    {
