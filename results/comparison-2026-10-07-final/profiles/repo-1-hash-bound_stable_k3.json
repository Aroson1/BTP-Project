{
  "schema": 2,
  "workflow": "repo-1-hash",
  "training_runs": 3,
  "include_rare": false,
  "rules": [
    {
      "kind": "read",
      "resource": "$input",
      "source": "paired-task-evidence"
    },
    {
      "kind": "write",
      "resource": "$output",
      "source": "paired-task-evidence"
    },
    {
      "kind": "exec",
      "resource": "/usr/local/bin/python3.13",
      "source": "stable-evidence"
    },
    {
      "kind": "read",
      "resource": "/etc/passwd",
      "source": "stable-evidence"
    },
    {
      "kind": "read",
      "resource": "/etc/ssl/openssl.cnf",
      "source": "stable-evidence"
    },
    {
      "kind": "read",
      "resource": "/proc/sys/vm/overcommit_memory",
      "source": "stable-evidence"
    }
  ],
  "scopes": {
    "input": "/workspace/repo-1/input",
    "output": "/workspace/repo-1/out"
  },
  "protect_secrets": true,
  "trace_hashes": [
